<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http / ws) is allowed ONLY to the phone's own loopback, for the WebView -> LocalServer ingest socket
  (docs/PROTOCOL_SPEC.md §2, §4). Everything else keeps Android's default: cleartext blocked.
  Added for experiment E1/E2 follow-up; see docs/TECHNICAL_DECISIONS.md D-021.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
